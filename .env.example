# 复制为 .env 后填写真实值；.env 不入库（见 .gitignore）

# —— Embedding：bge-m3 API ——
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxx
EMBEDDING_MODEL=bge-m3

# —— Reranker：默认复用 Embedding 的服务 ——
RERANK_API_BASE=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-xxxxx
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# —— 生成 LLM ——
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-xxxxx
LLM_MODEL=deepseek-v4-pro

# —— 独立评测裁判 LLM ——
EVAL_LLM_API_BASE=https://api.deepseek.com
EVAL_LLM_API_KEY=sk-xxxxx
EVAL_LLM_MODEL=deepseek-v4-flash

# —— 配置文件（默认 config/default.yaml）——
LEGALRAG_CONFIG=config/default.yaml

# —— PostgreSQL：元数据、访问策略与文档版本关系 ——
POSTGRES_DSN=postgresql://<username>:<password>@<host>:<port>/<database>
LEGALRAG_TEST_POSTGRES_DSN=postgresql://<username>:<password>@<host>:<port>/<test_database>

# —— Redis：多轮会话存储 ——
REDIS_URL=redis://127.0.0.1:6379/0
LEGALRAG_TEST_REDIS_URL=redis://127.0.0.1:6379/1
