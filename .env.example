# 复制为 .env 后填写真实值；.env 不入库（见 .gitignore）

# —— Embedding：bge-m3，走 API（MVP 无 GPU 退路）——
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# —— Reranker：留空时复用 Embedding 的 base/key ——
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# —— 生成 LLM：Qwen2.5 / DeepSeek，OpenAI 兼容协议 ——
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=qwen2.5-7b-instruct

# —— 配置文件（默认 config/default.yaml）——
LEGALRAG_CONFIG=config/default.yaml
